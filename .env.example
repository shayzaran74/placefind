# ── Application ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# ── Panel girişi (HTTP Basic Auth) ───────────────────────────────────────────
# Siteye girmek için sorulan kullanıcı adı / şifre. /health muaftır.
AUTH_ENABLED=true
AUTH_USER=placefind
AUTH_PASSWORD=shayzaran74
AUTH_REALM=PlaceFind SaaS

# Host port bindings used by docker-compose
APP_PORT=3010
MONGO_PORT=27020
REDIS_PORT=6380

# ── Data stores ──────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27019/placefind_db
REDIS_URI=redis://localhost:6380

# ── Place data providers ─────────────────────────────────────────────────────
# maps_scraper = free Playwright Google Maps scraper (default, no API key).
# Fallbacks run only if the primary is blocked AND their key is set.
PLACES_PROVIDER=maps_scraper
PLACES_FALLBACK_PROVIDERS=outscraper,apify

# Google Maps scraper. 'en' keeps aria-labels and decimals stable to parse.
MAPS_LOCALE=en
SCRAPER_MIN_DELAY_MS=2000
SCRAPER_MAX_DELAY_MS=3000
SCRAPER_MAX_SCROLLS=15
# Residential proxy, e.g. http://user:pass@host:port — reduces IP-ban risk.
SCRAPER_PROXY_URL=
# Worker throughput cap (jobs per window) — paces scraping to avoid bans.
SCRAPER_RATE_LIMIT_MAX=15
SCRAPER_RATE_LIMIT_DURATION_MS=60000

# Hosted Google Maps scrapers (~$2-4 / 1.000 places). Optional fallbacks.
OUTSCRAPER_API_KEY=
APIFY_API_KEY=
APIFY_ACTOR_ID=compass/crawler-google-places

# ── Google Places API (optional, PLACES_PROVIDER=places_api) ──────────────────
# Not required. ~$32 / 1.000 places; the scraper covers the same ground free.
GOOGLE_PLACES_API_KEY=
# Set to false to fail loudly instead of returning sample venues.
ALLOW_MOCK_DATA=true

# ── WebP image pipeline ──────────────────────────────────────────────────────
WEBP_QUALITY=85
WEBP_MAX_WIDTH=1200
UPLOADS_DIR=./uploads/images
# Public origin prefixed to stored .webp paths (e.g. https://cdn.placefind.io)
CDN_BASE_URL=

# ── Menu site crawler (URL ingestion) ────────────────────────────────────────
# A QR menu's landing page is usually a category grid with no prices, so the
# scraper also fetches the section pages it links to.
MENU_CRAWL_ENABLED=true
# Page budget per venue, entry page included.
MENU_CRAWL_MAX_PAGES=20
# Pacing between same-origin pages. The multi-second Maps delay is not needed
# here: these are pages of a menu we were pointed at, not a search engine.
MENU_CRAWL_DELAY_MS=400
# Honour the site's robots.txt. Leave on unless you own the site.
MENU_CRAWL_RESPECT_ROBOTS=true

# ── Scraper workers ──────────────────────────────────────────────────────────
SCRAPER_CONCURRENCY=2
SCRAPER_TIMEOUT_MS=20000
PLAYWRIGHT_ENABLED=true
# Path to a local Chromium, or a remote browser websocket endpoint.
PLAYWRIGHT_EXECUTABLE_PATH=
PLAYWRIGHT_WS_ENDPOINT=

# ── API rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
